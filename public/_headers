/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://fotbooth-rooms.aliifikriii25.workers.dev wss://fotbooth-rooms.aliifikriii25.workers.dev; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/ar/*
  Cache-Control: public, max-age=31536000, immutable
